new file mode 100644
index 00000000..db2a3737
--- /dev/null
+++ b/app/src/main/java/app/gamenative/externaldisplay/SpanDisplayController.kt
@@ -0,0 +1,206 @@
+package app.gamenative.externaldisplay
+
+import android.app.Presentation
+import android.content.Context
+import android.hardware.display.DisplayManager
+import android.os.Handler
+import android.os.Looper
+import android.view.Display
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.widget.FrameLayout
+import app.gamenative.PluviaApp
+import com.winlator.renderer.VulkanRenderer
+import com.winlator.widget.TouchpadView
+import com.winlator.widget.XServerView
+import com.winlator.xserver.XServer
+import timber.log.Timber
+
+/**
+ * Span mode (AYN Thor dual screen): the Wine X screen is wider than the top panel.
+ * The primary renderer shows X x in [0, splitX) at 1:1 on display 0; this controller puts a
+ * second XServerView (a "mirror" VulkanRenderer fed by the primary) on the presentation display
+ * showing x in [splitX, W) at 1:1, with a touchscreen-mode TouchpadView on top mapped to that region.
+ *
+ * The secondary view is never registered as xServer's renderer and never becomes
+ * PluviaApp.xServerView / PluviaApp.touchpadView.
+ */
+class SpanDisplayController(
+    private val context: Context,
+    private val xServer: XServer,
+    private val primary: VulkanRenderer,
+    private val splitX: Int,
+) {
+    private val displayManager = context.getSystemService(DisplayManager::class.java)
+    private var presentation: SpanPresentation? = null
+    private var secondaryView: XServerView? = null
+    private var secondaryRenderer: VulkanRenderer? = null
+    private var started = false
+
+    private val screenW: Int get() = xServer.screenInfo.width.toInt()
+    private val screenH: Int get() = xServer.screenInfo.height.toInt()
+
+    private val displayListener = object : DisplayManager.DisplayListener {
+        override fun onDisplayAdded(displayId: Int) = update()
+
+        override fun onDisplayRemoved(displayId: Int) {
+            if (presentation?.display?.displayId == displayId) {
+                Timber.tag(TAG).i("display %d removed", displayId)
+                teardown()
+            }
+            update()
+        }
+
+        override fun onDisplayChanged(displayId: Int) {
+            if (presentation?.display?.displayId == displayId) update()
+        }
+    }
+
+    fun start() {
+        if (started) return
+        started = true
+        Timber.tag(TAG).i("start: X screen %dx%d, splitX=%d, top src=(0,0,%d,%d)", screenW, screenH, splitX, splitX, screenH)
+        primary.setSpanViewport(0, 0, splitX, screenH)
+        displayManager?.registerDisplayListener(displayListener, Handler(Looper.getMainLooper()))
+        update()
+    }
+
+    fun stop() {
+        if (!started) return
+        started = false
+        Timber.tag(TAG).i("stop")
+        teardown()
+        try {
+            displayManager?.unregisterDisplayListener(displayListener)
+        } catch (_: Exception) {
+        }
+        primary.setSpanViewport(0, 0, 0, 0)
+    }
+
+    private fun update() {
+        if (!started) return
+        val target = findPresentationDisplay()
+        if (target == null) {
+            Timber.tag(TAG).w("no presentation display found; only x < %d is visible", splitX)
+            teardown()
+            return
+        }
+        if (presentation != null && presentation?.display?.displayId == target.displayId) return
+        teardown()
+
+        val w = screenW
+        val h = screenH
+        val srcW = w - splitX
+        Timber.tag(TAG).i(
+            "display id=%d name=%s mode=%dx%d; bottom src=(%d,0,%d,%d)",
+            target.displayId, target.name, target.mode.physicalWidth, target.mode.physicalHeight, splitX, srcW, h,
+        )
+
+        val p = SpanPresentation(context, target)
+        try {
+            p.show()
+        } catch (e: Exception) {
+            Timber.tag(TAG).e(e, "presentation show failed on display %d", target.displayId)
+            return
+        }
+        presentation = p
+        Timber.tag(TAG).i("presentation shown on display %d", target.displayId)
+
+        val view = XServerView(p.context, xServer, "vulkan")
+        val r = view.renderer as? VulkanRenderer
+        if (r == null) {
+            Timber.tag(TAG).w("secondary XServerView has no VulkanRenderer; dismissing")
+            view.release()
+            p.dismiss()
+            presentation = null
+            return
+        }
+        r.setMirror(true)
+        r.setVkPresentMode(primary.getVkPresentMode())
+        primary.getUnviewableWMClasses()?.let { r.setUnviewableWMClasses(*it) }
+        r.setSpanViewport(splitX, 0, srcW, h)
+        r.setCursorVisible(primary.isCursorVisible())
+        p.root.addView(
+            view,
+            FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT),
+        )
+
+        val touch = TouchpadView(p.context, xServer, false)
+        touch.layoutParams = FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
+        // Same gestures as the top screen (TouchGestureConfig has no scroll-wheel two-finger-drag action; pinch = wheel).
+        PluviaApp.touchpadView?.getGestureConfig()?.let { touch.setGestureConfig(it) }
+        touch.setTouchscreenMode(true)
+        touch.setAbsoluteRegion(splitX, 0, srcW, h)
+        p.root.addView(touch)
+
+        secondaryView = view
+        secondaryRenderer = r
+        primary.addMirror(r)
+        Timber.tag(TAG).i("mirror renderer attached (touch region x=%d..%d)", splitX, w)
+    }
+
+    private fun teardown() {
+        val r = secondaryRenderer
+        val v = secondaryView
+        val p = presentation
+        if (r == null && v == null && p == null) return
+        Timber.tag(TAG).i("teardown: display=%s", p?.display?.displayId)
+        if (r != null) primary.removeMirror(r)
+        try {
+            p?.root?.removeAllViews()
+        } catch (e: Exception) {
+            Timber.tag(TAG).w(e, "removeAllViews failed")
+        }
+        try {
+            v?.release()
+        } catch (e: Exception) {
+            Timber.tag(TAG).w(e, "secondary view release failed")
+        }
+        try {
+            p?.dismiss()
+        } catch (e: Exception) {
+            Timber.tag(TAG).w(e, "presentation dismiss failed")
+        }
+        secondaryRenderer = null
+        secondaryView = null
+        presentation = null
+        Timber.tag(TAG).i("teardown done")
+    }
+
+    private fun findPresentationDisplay(): Display? {
+        val currentDisplay = context.display ?: return null
+        return displayManager
+            ?.getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION)
+            ?.firstOrNull { display ->
+                display.displayId != currentDisplay.displayId && display.name != "HiddenDisplay"
+            }
+    }
+
+    private companion object {
+        const val TAG = "SpanDisplay"
+    }
+}
+
+private class SpanPresentation(
+    outerContext: Context,
+    display: Display,
+) : Presentation(outerContext, display) {
+    val root: FrameLayout by lazy {
+        FrameLayout(context).apply {
+            layoutParams = FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT,
+            )
+        }
+    }
+
+    override fun onCreate(savedInstanceState: android.os.Bundle?) {
+        super.onCreate(savedInstanceState)
+        // Keep focus / controller input on the main activity.
+        window?.setFlags(
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
+        )
+        setContentView(root)
+    }
+}
