+        // "WoW Span": unofficial fork identity on top of spantest (same span defaults, debug signing).
+        // Placeholder values, change them for your own fork; every identity value lives in this block, except the
+        // applicationId (io.github.example.wowspan), which androidComponents sets at the end of
+        // this file. namespace stays app.gamenative. A release key is a separate decision.
+        create("thorspan") {
+            initWith(getByName("spantest"))
+            applicationIdSuffix = null
+            matchingFallbacks += listOf("debug")
+            val label = "WoW Span"
+            resValue("string", "app_name", label)
+            manifestPlaceholders["appLabel"] = label // every locale, not only the default one
+            buildConfigField("String", "FORK_NOTICE", "\"An unofficial fork of GameNative. Not affiliated with or supported by the GameNative maintainers.\"")
+            // Set this to your own fork URL; empty falls back to the upstream link.
+            buildConfigField("String", "FORK_SOURCE_URL", "\"\"")
+            // Never tell fork users to "update" to stock, never send fork bug reports to upstream's relay.
+            buildConfigField("boolean", "UPDATE_CHECK_ENABLED", "false")
+            buildConfigField("boolean", "DEBUG_REPORT_UPLOAD_ENABLED", "false")
+        }
         create("release-gold") {
             isMinifyEnabled = true
             isShrinkResources = true
@@ -434,6 +459,14 @@ android {
